# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Пароль PostgreSQL:            openssl rand -hex 16
POSTGRES_PASSWORD=
# Ключ HMAC (коды, заказы, журнал), не короче 32 символов:  openssl rand -hex 32
AGENTPAY_SECRET_KEY=
# auto | ollama | openai | rules
AGENTPAY_LLM=auto
AGENTPAY_LLM_MODEL=qwen2.5:3b
# OpenAI-совместимый API. Пусто — Ollama из compose. Примеры:
#   Qwen3 на Mac (MLX): AGENTPAY_LLM=openai, AGENTPAY_LLM_BASE_URL=http://host.docker.internal:8081/v1,
#                       AGENTPAY_LLM_MODEL=mlx-community/Qwen3-8B-4bit
#   DeepSeek:           AGENTPAY_LLM=openai, AGENTPAY_LLM_BASE_URL=https://api.deepseek.com, AGENTPAY_LLM_MODEL=deepseek-chat
#                       Внешний API: текст поручения уходит за пределы контура банка — только с согласия банка.
AGENTPAY_LLM_BASE_URL=
# Ключ API. Файл .env в git не попадает; ключ не вставлять в код, тикеты и чаты.
AGENTPAY_LLM_API_KEY=
# Ограничение частоты «число/секунд»: поручений на сессию, поручений и новых сессий с одного адреса
# AGENTPAY_RATE_TASKS=20/60
# AGENTPAY_RATE_TASKS_IP=120/60
# AGENTPAY_RATE_SESSIONS_IP=60/60
# Режим рассуждений (Qwen3): auto — выключен для qwen3, off — всегда выключен, on — как у модели
AGENTPAY_LLM_THINKING=auto
# Фиксированная дата для воспроизводимого демо (пусто — системная)
AGENTPAY_TODAY=
# 1 — cookie сессии только по HTTPS (за TLS-терминатором)
AGENTPAY_COOKIE_SECURE=0
AGENTPAY_PORT=8080
